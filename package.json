{
  "name": "ashitakanji",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "examples:references": "node scripts/collect-example-references.mjs",
    "examples:build": "node scripts/build-final-examples.mjs",
    "audio:opus": "node scripts/convert-audio-to-opus.mjs",
    "audio:map": "node scripts/gen-audio-map.mjs",
    "audio:verify": "node scripts/convert-audio-to-opus.mjs --verify-only",
    "audio:prepare": "npm run audio:opus && npm run audio:map && npm run audio:verify",
    "tts:audit:examples": "python3 scripts/audit-example-tts.py --extension ogg --codec opus --audio-map src/lib/audio/audioMap.gen.android.ts --report data/pdf-vocab/example_tts_validation_report.json",
    "kanji:audit": "python3 scripts/audit-kanji-data.py",
    "kanji:semantic-apply": "python3 scripts/apply-kanji-semantic-review.py",
    "kanji:semantic-queue": "python3 scripts/build-kanji-semantic-review-queue.py",
    "track-a:successors": "node scripts/gen-word-id-successors.mjs",
    "track-a:build": "npm run examples:build && node scripts/build-jlpt-db.mjs --trusted-final --qa data/pdf-vocab/jlpt_final_wordlist.csv --examples data/pdf-vocab/examples_final_qa_work.csv",
    "track-a:naver-examples": "node scripts/collect-naver-examples.mjs",
    "vocab:naver-audit": "python3 scripts/audit-vocab-naver-full.py --search-cache .cache/naver-full-search-2026-08-20-7050.json --report data/pdf-vocab/naver_full_verification.json --issues data/pdf-vocab/naver_full_verification_flags.csv --failures data/pdf-vocab/naver_full_verification_failures.csv --queue data/pdf-vocab/naver_full_verification_queue.csv",
    "track-a:translate": "node scripts/build-jlpt-db.mjs --translate",
    "release-gate": "node scripts/release-gate.mjs",
    "ci-check": "npm run typecheck && npm run test && npm run lint",
    "ui:capture": "node scripts/ui-capture.mjs",
    "ui:diff": "node scripts/ui-diff.mjs",
    "ui:approve": "node scripts/ui-approve.mjs",
    "release-check": "npm run ci-check && npm run release-gate"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.62.0",
    "expo": "~54.0.37",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-blur": "~15.0.8",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.14",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-linking": "~8.0.12",
    "expo-media-library": "~18.2.1",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-speech": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-tracking-transparency": "~6.0.8",
    "expo-updates": "~29.0.20",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-google-mobile-ads": "^15.8.3",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-view-shot": "4.0.3",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "ts-fsrs": "5.4.2",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@testing-library/react-native": "^13.2.0",
    "@types/node": "^22.10.0",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.12",
    "eslint": "^9.25.1",
    "eslint-config-expo": "~10.0.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2",
    "vitest": "^2.1.0"
  }
}
